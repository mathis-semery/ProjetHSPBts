{% extends 'base.html.twig' %}

{% block title %}{{ canal.nom }} - Chat{% endblock %}

{% block body %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} mt-4">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div class="container py-10">

        <div class="card mb-10">
            <div class="card-body p-10">
                <h1 class="fs-2hx fw-bold text-dark mb-4">{{ canal.nom }}</h1>
                <p class="fs-5 text-gray-600 mb-0">{{ canal.description }}</p>
            </div>
        </div>

        {% if app.user %}
            <div class="card mb-10">
                <div class="card-header border-0 pt-6">
                    <h3 class="card-title">
                        <span class="fw-bold fs-3">Créer un nouveau post</span>
                    </h3>
                </div>
                <div class="card-body pt-0">
                    {{ form_start(formPost) }}
                    <div class="mb-5">
                        {{ form_row(formPost.titre, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    </div>
                    <div class="mb-5">
                        {{ form_row(formPost.texte, {'attr': {'class': 'form-control form-control-lg', 'rows': '4'}}) }}
                    </div>
                    <button class="btn btn-primary">Publier</button>
                    {{ form_end(formPost) }}
                </div>
            </div>
        {% endif %}

        {% for post in canal.posts %}
            <div class="card mb-8">
                <div class="card-header d-flex justify-content-between">
                    <div>
                        <h4 class="fw-bold mb-1">{{ post.titre ?? 'Post' }}</h4>
                        <span class="text-muted fs-7">Par {{ post.refUser.userIdentifier }}</span>
                    </div>

                    <span class="badge badge-light-primary">{{ post.reponses|length }} réponses</span>
                </div>

                <div class="card-body">
                    <p class="text-gray-800 fs-5 mb-6">{{ post.texte }}</p>

                    <h5 class="fw-semibold mb-3">Réponses :</h5>
                    {% if post.reponses is not empty %}
                        <div class="scroll-y pe-4" style="max-height: 250px;">
                            {% for reponse in post.reponses %}
                                <div class="d-flex align-items-start mb-4">
                                    <div class="symbol symbol-40px symbol-circle me-3">
                                        <span class="symbol-label bg-light-primary text-primary fw-bold">
                                            {{ reponse.refUser.userIdentifier|first|upper }}
                                        </span>
                                    </div>

                                    <div>
                                        <div class="fw-semibold">{{ reponse.refUser.userIdentifier }}</div>
                                        <div class="text-gray-700">{{ reponse.texte }}</div>
                                        <div class="text-muted fs-8">{{ reponse.dateHeure|date('d/m/Y H:i') }}</div>

                                        {% if app.user and (app.user == reponse.refUser or 'ROLE_ADMIN' in app.user.roles) %}
                                            <button class="btn btn-sm btn-danger mt-1"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteReponseModal{{ reponse.id }}">
                                                Supprimer
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="modal fade" id="deleteReponseModal{{ reponse.id }}" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title text-danger">Supprimer cette réponse ?</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="fs-5">Voulez-vous vraiment supprimer cette réponse ?</p>
                                                <p class="text-muted">Cette action est définitive.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button class="btn btn-light" data-bs-dismiss="modal">Annuler</button>

                                                <form method="post" action="{{ path('app_reponse_delete', {'id': reponse.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reponse.id) }}">
                                                    <button class="btn btn-danger">Supprimer</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted fst-italic">Aucune réponse pour ce post.</p>
                    {% endif %}

                    {% if app.user %}
                        <form method="post" class="d-flex flex-column gap-3">
                            <textarea name="texte" rows="2" class="form-control" required></textarea>
                            <input type="hidden" name="post_id" value="{{ post.id }}">
                            <button class="btn btn-light-primary align-self-end">Répondre</button>
                        </form>
                    {% endif %}

                    {% if app.user and (app.user == post.refUser or 'ROLE_ADMIN' in app.user.roles) %}
                        <button class="btn btn-danger btn-sm mt-4"
                                data-bs-toggle="modal"
                                data-bs-target="#deletePostModal{{ post.id }}">
                            Supprimer ce post
                        </button>

                        <div class="modal fade" id="deletePostModal{{ post.id }}" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-danger">Supprimer ce post ?</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p class="fs-5">Voulez-vous vraiment supprimer le post :</p>
                                        <p class="fw-bold">“{{ post.titre }}”</p>
                                        <p class="text-muted">Cette action est définitive.</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                                        <form method="post" action="{{ path('app_post_delete', {'id': post.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                            <button class="btn btn-danger">Supprimer</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                    {% endif %}

                </div>
            </div>

        {% else %}
            <div class="alert alert-info p-5">Aucun post pour ce canal.</div>
        {% endfor %}

        <a href="{{ path('app_canal_index') }}" class="btn btn-light mt-10">
            Retour à la liste des canaux
        </a>

    </div>
{% endblock %}
