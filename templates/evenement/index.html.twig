{% extends 'base.html.twig' %}

{% block title %}Gestion des Événements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.datatables.net/v/bs5/dt-2.1.8/datatables.min.css" rel="stylesheet">
    <style>
        .dt-search input {
            border-radius: 0.475rem !important;
            padding: 0.5rem 1rem;
        }
        .dt-length select {
            border-radius: 0.475rem !important;
            padding: 0.5rem 1rem;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-6">
        <h1 class="h2 mb-0">Gestion des Événements</h1>
        <a href="{{ path('app_evenement_new') }}" class="btn btn-primary">
            <i class="ki-duotone ki-plus fs-2"></i>
            <span class="ms-1">Ajouter un événement</span>
        </a>
    </div>

    {% if evenements is empty %}
        <div class="alert alert-light-primary d-flex align-items-center p-5 mb-0">
            <i class="ki-duotone ki-information fs-2x text-primary me-4"></i>
            <div class="d-flex flex-column">
                <span class="fw-bold fs-6">Aucun événement</span>
                <span>Aucun événement n’a été créé pour le moment.</span>
            </div>
        </div>
    {% else %}
        <div class="table-responsive">
            <table id="kt_datatable_evenements" class="table align-middle table-row-dashed fs-6 gy-5">
                <thead>
                <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                    <th class="min-w-50px">ID</th>
                    <th class="min-w-100px">Type</th>
                    <th class="min-w-150px">Titre</th>
                    <th class="min-w-200px">Adresse</th>
                    <th class="text-center min-w-100px">Places</th>
                    <th class="min-w-150px">Éléments requis</th>
                    <th class="text-end min-w-125px">Actions</th>
                </tr>
                </thead>
                <tbody class="fw-semibold text-gray-700">
                {% for evenement in evenements %}
                    <tr>
                        <td>{{ evenement.id }}</td>
                        <td>
                            <span class="badge badge-light-{{ {'formation': 'info', 'rencontre': 'success', 'atelier': 'primary', 'autre': 'secondary'}[evenement.type|default('autre')]|default('secondary') }} fw-bold">
                                {{ evenement.type|capitalize }}
                            </span>
                        </td>
                        <td><strong>{{ evenement.titre }}</strong></td>
                        <td>{{ evenement.adresse ?: '—' }}</td>
                        <td class="text-center">{{ evenement.nombreDePlace ?? 'Illimité' }}</td>
                        <td>
                            {% if evenement.elementRequis %}
                                {{ evenement.elementRequis|length > 40 ? evenement.elementRequis|slice(0, 40) ~ '…' : evenement.elementRequis }}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-sm btn-outline-info">Voir</a>
                            <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                            <form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" class="d-inline" onsubmit="return confirm('Confirmer la suppression ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.8/datatables.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const table = new DataTable('#kt_datatable_evenements', {
                responsive: true,
                search: {
                    return: true
                },
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.1.8/i18n/fr-FR.json'
                },
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: true, targets: [0] },
                    { orderable: true, targets: [1] },
                    { orderable: true, targets: [2] },
                    { orderable: false, targets: [6] }
                ]
            });
        });
    </script>
{% endblock %}
