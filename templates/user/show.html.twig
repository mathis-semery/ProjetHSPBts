{# templates/user/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Détails de {{ user.prenom }} {{ user.nom }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>{{ user.prenom }} {{ user.nom }}</h1>
        <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Retour</a>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">{{ user.email }}</dd>

        <dt class="col-sm-3">Rôles</dt>
        <dd class="col-sm-9">
            {% for role in user.roles %}
                <span class="badge bg-{% if role == 'ROLE_ADMIN' %}danger{% else %}secondary{% endif %}">{{ role }}</span>
            {% endfor %}
        </dd>

        <dt class="col-sm-3">Validé</dt>
        <dd class="col-sm-9">{{ user.etatValidation ? 'Oui' : 'Non' }}</dd>

        <dt class="col-sm-3">Métier</dt>
        <dd class="col-sm-9">{{ user.metier }}</dd>

        <dt class="col-sm-3">Créé le</dt>
        <dd class="col-sm-9">{{ user.dateCreation ? user.dateCreation|date('d/m/Y') }}</dd>
    </dl>
{% endblock %}
