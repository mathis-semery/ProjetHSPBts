{% extends 'base.html.twig' %}

{% block title %}Offres d'emploi{% endblock %}

{% block body %}
    <div class="container py-10">

        <!-- Header -->
        <div class="card mb-6">
            <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <div>
                    <h1 class="fs-2hx fw-bold text-dark mb-2">
                        {% if mes_offres == '1' %}
                            Offres de mon entreprise
                        {% else %}
                            Offres d'emploi
                        {% endif %}
                    </h1>
                    <p class="text-gray-600 mb-0">
                        {% if mes_offres == '1' %}
                            Gérez les offres de votre entreprise
                        {% else %}
                            Consultez les opportunités de carrière dans le groupe GDH.
                        {% endif %}
                    </p>
                </div>

                <div class="d-flex gap-2 mt-4 mt-md-0">
                    {% if (is_granted('ROLE_ADMIN') or is_granted('ROLE_PARTENAIRE')) and app.user.refEntreprise %}
                        {% if mes_offres == '1' %}
                            <a href="{{ path('app_offre_index') }}" class="btn btn-light-secondary">
                                <i class="ki-duotone ki-arrow-left fs-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                                Toutes les offres
                            </a>
                        {% else %}
                            <a href="{{ path('app_offre_index', {'mes_offres': '1'}) }}" class="btn btn-light-primary">
                                <i class="ki-duotone ki-briefcase fs-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                                Mes offres
                            </a>
                        {% endif %}
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_PARTENAIRE') %}
                        <a href="{{ path('app_offre_new') }}" class="btn btn-primary">
                            <i class="ki-duotone ki-plus fs-2"></i>
                            Créer une offre
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Barre de recherche et filtres -->
        <div class="card mb-6">
            <div class="card-body">
                <form method="get" action="{{ path('app_offre_index') }}" class="row g-4">
                    <!-- Barre de recherche -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Rechercher</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="ki-duotone ki-magnifier fs-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                            </span>
                            <input type="text"
                                   name="search"
                                   class="form-control"
                                   placeholder="Rechercher par titre ou description..."
                                   value="{{ search }}">
                        </div>
                    </div>

                    <!-- Filtre par type -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Type de contrat</label>
                        <select name="type" class="form-select">
                            <option value="">Tous les types</option>
                            <option value="Stage" {% if type == 'Stage' %}selected{% endif %}>Stage</option>
                            <option value="Alternance" {% if type == 'Alternance' %}selected{% endif %}>Alternance</option>
                            <option value="CDD" {% if type == 'CDD' %}selected{% endif %}>CDD</option>
                            <option value="CDI" {% if type == 'CDI' %}selected{% endif %}>CDI</option>
                        </select>
                    </div>

                    <!-- Boutons -->
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="d-flex gap-2 w-100">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="ki-duotone ki-filter-search fs-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                                Filtrer
                            </button>
                            {% if search or type %}
                                <a href="{{ path('app_offre_index') }}" class="btn btn-light-secondary">
                                    <i class="ki-duotone ki-cross fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Résultats -->
        {% if search or type %}
            <div class="alert alert-info d-flex align-items-center mb-6">
                <i class="ki-duotone ki-information-4 fs-2x me-3">
                    <span class="path1"></span>
                    <span class="path2"></span>
                    <span class="path3"></span>
                </i>
                <span>{{ offres|length }} offre(s) trouvée(s)</span>
            </div>
        {% endif %}

        {% if offres is not empty %}
            <div class="row g-6">
                {% for offre in offres %}
                    <div class="col-md-6 col-xl-4">
                        <div class="card card-flush h-100 shadow-sm hover-elevate-up transition-all">
                            <div class="card-header border-0 pt-6">
                                <div class="d-flex justify-content-between align-items-start w-100">
                                    <div class="flex-grow-1">
                                        <h3 class="card-title">
                                            <span class="fw-bold fs-3 text-dark">
                                                {{ offre.titre|length > 40 ? offre.titre|slice(0,40) ~ '...' : offre.titre }}
                                            </span>
                                        </h3>
                                        <span class="badge badge-light-{{ offre.etat ? 'success' : 'secondary' }} mt-2">
                                            {{ offre.etat ? 'Ouverte' : 'Fermée' }}
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body py-5">
                                <!-- Type de contrat -->
                                <div class="d-flex align-items-center mb-3">
                                    <i class="ki-duotone ki-briefcase fs-2 text-primary me-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                    <span class="text-gray-800 fw-semibold">{{ offre.type }}</span>
                                </div>

                                <!-- Salaire -->
                                {% if offre.salaire %}
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="ki-duotone ki-euro fs-2 text-success me-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                            <span class="path3"></span>
                                        </i>
                                        <span class="text-gray-800">{{ offre.salaire }}€ / an</span>
                                    </div>
                                {% endif %}

                                <!-- Description -->
                                <p class="text-gray-700 mt-4 mb-4">
                                    {{ offre.description|length > 100 ? offre.description|slice(0,100) ~ '...' : offre.description }}
                                </p>

                                <!-- Actions -->
                                <div class="d-flex gap-2">
                                    <a href="{{ path('app_offre_show', {'id': offre.id}) }}" class="btn btn-sm btn-primary flex-grow-1">
                                        <i class="ki-duotone ki-eye fs-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                            <span class="path3"></span>
                                        </i>
                                        Voir l'offre
                                    </a>
                                    {% if (is_granted('ROLE_ADMIN') or is_granted('ROLE_PARTENAIRE')) and offre.auteur == app.user %}
                                        <a href="{{ path('app_offre_edit', {'id': offre.id}) }}" class="btn btn-sm btn-light-primary">
                                            <i class="ki-duotone ki-pencil fs-2">
                                                <span class="path1"></span>
                                                <span class="path2"></span>
                                            </i>
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="alert alert-info d-flex align-items-center p-5">
                <i class="ki-duotone ki-information-5 fs-2hx text-info me-4">
                    <span class="path1"></span>
                    <span class="path2"></span>
                    <span class="path3"></span>
                </i>
                <div class="d-flex flex-column">
                    <h4 class="mb-1 text-info">Aucune offre disponible</h4>
                    <span>Aucune offre d'emploi n'est actuellement publiée.</span>
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}
