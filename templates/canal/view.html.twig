{% extends 'base.html.twig' %}

{% block title %}{{ canal.nom }} - Chat{% endblock %}

{% block body %}
    <div class="container py-10">

        <div class="card mb-10">
            <div class="card-body p-10">
                <h1 class="fs-2hx fw-bold text-dark mb-4">{{ canal.nom }}</h1>
                <p class="fs-5 text-gray-600 mb-0">{{ canal.description }}</p>
            </div>
        </div>

        {% if app.user %}
            <div class="card mb-10">
                <div class="card-header border-0 pt-6">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold fs-3 mb-1">Créer un nouveau post</span>
                        <span class="text-muted mt-1 fw-semibold fs-7">Partagez une idée ou un message</span>
                    </h3>
                </div>
                <div class="card-body pt-0">
                    {{ form_start(formPost) }}
                    <div class="mb-5">
                        {{ form_row(formPost.titre, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Titre du post'}}) }}
                    </div>
                    <div class="mb-5">
                        {{ form_row(formPost.texte, {'attr': {'class': 'form-control form-control-lg', 'rows': '4', 'placeholder': 'Écrivez votre message...'}}) }}
                    </div>
                    <button class="btn btn-primary">Publier</button>
                    {{ form_end(formPost) }}
                </div>
            </div>
        {% endif %}

        {% for post in canal.posts %}
            <div class="card mb-8">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-1">{{ post.titre ?? 'Post' }}</h4>
                        <span class="text-muted fs-7">Par {{ post.refUser.userIdentifier }}</span>
                    </div>
                    <span class="badge badge-light-primary">{{ post.reponses|length }} réponses</span>
                </div>

                <div class="card-body">
                    <p class="text-gray-800 fs-5 mb-6">{{ post.texte }}</p>

                    <div class="mb-6">
                        <h5 class="fw-semibold mb-3">Réponses :</h5>
                        {% if post.reponses is not empty %}
                            <div class="scroll-y pe-4" style="max-height: 250px;">
                                {% for reponse in post.reponses %}
                                    <div class="d-flex align-items-start mb-4">
                                        <div class="symbol symbol-40px symbol-circle me-3">
                            <span class="symbol-label bg-light-primary text-primary fw-bold">
                                {{ reponse.refUser.userIdentifier|first|upper }}
                            </span>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">{{ reponse.refUser.userIdentifier }}</div>
                                            <div class="text-gray-700">{{ reponse.texte }}</div>
                                            <div class="text-muted fs-8">{{ reponse.dateHeure|date('d/m/Y H:i') }}</div>

                                            {% if app.user and (app.user == reponse.refUser or 'ROLE_ADMIN' in app.user.roles) %}
                                                <button type="button" class="btn btn-sm btn-danger mt-1" data-bs-toggle="modal" data-bs-target="#deleteReponseModal{{ reponse.id }}">
                                                    Supprimer
                                                </button>

                                                <div class="modal fade" id="deleteReponseModal{{ reponse.id }}" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title text-danger">Supprimer cette réponse ?</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p>Cette action est <strong class="text-danger">définitive</strong>.</p>
                                                                <p>{{ reponse.texte }}</p>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                                                                <form method="post" action="{{ path('app_reponse_delete', {'id': reponse.id}) }}">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reponse.id) }}">
                                                                    <button class="btn btn-danger">Confirmer la suppression</button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted fst-italic">Aucune réponse pour ce post.</p>
                        {% endif %}
                    </div>

                    {% if app.user %}
                        <form method="post" class="d-flex flex-column gap-3">
                            <textarea name="texte" rows="2" class="form-control form-control-sm" placeholder="Écrire une réponse..." required></textarea>
                            <input type="hidden" name="post_id" value="{{ post.id }}">
                            <button type="submit" class="btn btn-sm btn-light-primary align-self-end">Répondre</button>
                        </form>
                    {% endif %}

                    {% if app.user and (app.user == post.refUser or 'ROLE_ADMIN' in app.user.roles) %}
                        <button type="button" class="btn btn-sm btn-danger mt-3" data-bs-toggle="modal" data-bs-target="#deletePostModal{{ post.id }}">
                            Supprimer ce post
                        </button>

                        <div class="modal fade" id="deletePostModal{{ post.id }}" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-danger">Supprimer ce post ?</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Cette action est <strong class="text-danger">définitive</strong>.</p>
                                        <p>{{ post.texte }}</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                                        <form method="post" action="{{ path('app_post_delete', {'id': post.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                            <button class="btn btn-danger">Confirmer la suppression</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="alert alert-info d-flex align-items-center p-5">
                <i class="ki-duotone ki-information fs-2hx me-3"></i>
                <div class="d-flex flex-column">
                    <h4 class="mb-1 text-info">Aucun post pour ce canal</h4>
                    <span>Commencez la discussion en créant un premier post ci-dessus.</span>
                </div>
            </div>
        {% endfor %}

        <div class="mt-10">
            <a href="{{ path('app_canal_index') }}" class="btn btn-light">
                Retour à la liste des canaux
            </a>
        </div>
    </div>
{% endblock %}
