{% extends 'base.html.twig' %}

{% block title %}Modifier le canal{% endblock %}

{% block body %}
    <div class="container py-10">

        <div class="card shadow-sm">
            <div class="card-header border-0 pt-6 pb-0">
                <h2 class="card-title fw-bold fs-2hx text-dark">Modifier le canal</h2>
            </div>

            <div class="card-body py-6">
                {{ form_start(form, {'attr': {'class': 'form'}}) }}

                <div class="mb-7">
                    {{ form_label(form.nom, 'Nom du canal', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control form-control-solid'}}) }}
                    {{ form_errors(form.nom) }}
                </div>

                <div class="mb-7">
                    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control form-control-solid'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="d-flex justify-content-between">
                    <form method="post" action="{{ path('app_canal_delete', {'id': canal.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ canal.id) }}">
                        <button class="btn btn-danger">
                            <i class="ki-duotone ki-trash fs-2 me-2"></i>Supprimer
                        </button>
                    </form>

                    <div>
                        <a href="{{ path('app_canal_index') }}" class="btn btn-light me-3">Annuler</a>
                        <button class="btn btn-primary">
                            <i class="ki-duotone ki-check fs-2 me-2"></i>Enregistrer
                        </button>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
