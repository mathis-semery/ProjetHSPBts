<div id="kt_header" class="header align-items-stretch"
     data-kt-sticky="true"
     data-kt-sticky-name="header"
     data-kt-sticky-offset="{default: '200px', lg: '300px'}">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-center">

        <!--begin::Header menu toggle-->
        <div class="d-flex align-items-center d-lg-none ms-n2 me-3" title="Show aside menu">
            <div class="btn btn-icon btn-custom w-35px h-35px w-md-40px h-md-40px" id="kt_header_menu_mobile_toggle">
                <i class="ki-duotone ki-abstract-14 fs-2"><span class="path1"></span><span class="path2"></span></i>
            </div>
        </div>
        <!--end::Header menu toggle-->

        <!--begin::Header Logo-->
        <div class="header-logo me-5 me-md-10 flex-grow-1 flex-lg-grow-0">
            <a href="{{ path('app_home') }}" class="d-flex align-items-center">
                <span class="fs-1 fs-lg-2x fw-bold text-dark">HSP</span>
            </a>
        </div>
        <!--end::Header Logo-->

        <!--begin::Wrapper-->
        <div class="d-flex align-items-stretch justify-content-between flex-lg-grow-1">
            <!--begin::Navbar-->
            <div class="d-flex align-items-stretch" id="kt_header_nav">

                <!--begin::Menu wrapper-->
                <div class="header-menu align-items-stretch"
                     data-kt-drawer="true"
                     data-kt-drawer-name="header-menu"
                     data-kt-drawer-activate="{default: true, lg: false}"
                     data-kt-drawer-overlay="true"
                     data-kt-drawer-width="{default:'200px', '300px': '225px'}"
                     data-kt-drawer-direction="start"
                     data-kt-drawer-toggle="#kt_header_menu_mobile_toggle"
                     data-kt-swapper="true"
                     data-kt-swapper-mode="prepend"
                     data-kt-swapper-parent="{default: '#kt_body', lg: '#kt_header_nav'}">

                    <!--begin::Menu-->
                    <div class="menu menu-rounded menu-column menu-lg-row menu-active-bg menu-title-gray-700 menu-state-primary menu-arrow-gray-500 fw-semibold my-5 my-lg-0 px-4 px-lg-0 align-items-stretch"
                         id="#kt_header_menu"
                         data-kt-menu="true">

                        <!--begin::Menu item - Accueil-->
                        <div class="menu-item me-0 me-lg-2">
                            <a class="menu-link py-3" href="{{ path('app_home') }}">
                                <span class="menu-title">Accueil</span>
                            </a>
                        </div>
                        <!--end::Menu item-->

                        <!--begin::Menu item - Offres-->
                        <div class="menu-item me-0 me-lg-2">
                            <a class="menu-link py-3" href="{{ path('app_offre_index') }}">
                                <span class="menu-title">Offres</span>
                            </a>
                        </div>
                        <!--end::Menu item-->

                        <!--begin::Menu item - Événements-->
                        <div class="menu-item me-0 me-lg-2">
                            <a class="menu-link py-3" href="{{ path('app_evenement_index') }}">
                                <span class="menu-title">Événements</span>
                            </a>
                        </div>
                        <!--end::Menu item-->

                        <!--begin::Menu item - Canaux-->
                        <div class="menu-item me-0 me-lg-2">
                            <a class="menu-link py-3" href="{{ path('app_canal_index') }}">
                                <span class="menu-title">Canaux</span>
                            </a>
                        </div>
                        <!--end::Menu item-->

                        <!--begin::Menu item - Admin (Admin only)-->
                        {% if is_granted('ROLE_ADMIN') %}
                            <div data-kt-menu-trigger="{default: 'click', lg: 'hover'}"
                                 data-kt-menu-placement="bottom-start"
                                 class="menu-item menu-lg-down-accordion me-0 me-lg-2">
                            <span class="menu-link py-3">
                                <span class="menu-title">Administration</span>
                                <span class="menu-arrow d-lg-none"></span>
                            </span>
                                <div class="menu-sub menu-sub-lg-down-accordion menu-sub-lg-dropdown p-0 w-100 w-lg-225px">
                                    <div class="menu-item">
                                        <a class="menu-link py-3" href="{{ path('app_user_index') }}">
                                        <span class="menu-icon">
                                            <i class="ki-duotone ki-user fs-2"></i>
                                        </span>
                                            <span class="menu-title">Utilisateurs</span>
                                        </a>
                                    </div>
                                    <div class="menu-item">
                                        <a class="menu-link py-3" href="{{ path('user_pending_index') }}">
                                        <span class="menu-icon">
                                            <i class="ki-duotone ki-time fs-2"></i>
                                        </span>
                                            <span class="menu-title">Utilisateurs en attente</span>
                                        </a>
                                    </div>
                                    <div class="menu-item">
                                        <a class="menu-link py-3" href="{{ path('app_entreprise_index') }}">
                                        <span class="menu-icon">
                                            <i class="ki-duotone ki-briefcase fs-2"></i>
                                        </span>
                                            <span class="menu-title">Entreprises</span>
                                        </a>
                                    </div>
                                    <div class="menu-item">
                                        <a class="menu-link py-3" href="{{ path('app_etablissement_index') }}">
                                        <span class="menu-icon">
                                            <i class="ki-duotone ki-building fs-2"></i>
                                        </span>
                                            <span class="menu-title">Établissements</span>
                                        </a>
                                    </div>
                                    <div class="menu-item">
                                        <a class="menu-link py-3" href="{{ path('app_hopital_index') }}">
                                        <span class="menu-icon">
                                            <i class="ki-duotone ki-hospital fs-2"></i>
                                        </span>
                                            <span class="menu-title">Hôpitaux</span>
                                        </a>
                                    </div>
                                    <div class="menu-item">
                                        <a class="menu-link py-3" href="{{ path('app_candidature_index') }}">
                                        <span class="menu-icon">
                                            <i class="ki-duotone ki-document fs-2"></i>
                                        </span>
                                            <span class="menu-title">Candidatures</span>
                                        </a>
                                    </div>
                                    <div class="menu-item">
                                        <a class="menu-link py-3" href="{{ path('app_inscription_index') }}">
                                        <span class="menu-icon">
                                            <i class="ki-duotone ki-notepad fs-2"></i>
                                        </span>
                                            <span class="menu-title">Inscriptions</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        <!--end::Menu item-->

                    </div>
                    <!--end::Menu-->
                </div>
                <!--end::Menu wrapper-->

            </div>
            <!--end::Navbar-->

            <!--begin::Topbar-->
            <div class="d-flex align-items-stretch flex-shrink-0">

                <!--begin::Toolbar wrapper-->
                <div class="topbar d-flex align-items-stretch flex-shrink-0">

                        <!--begin::Menu-->
                        <div class="menu menu-sub menu-sub-dropdown menu-column w-350px w-lg-375px" data-kt-menu="true" id="kt_menu_notifications">
                            <!--begin::Heading-->
                            <div class="d-flex flex-column bgi-no-repeat rounded-top"
                                 style="background-image:url('{{ asset('assets/media/patterns/header-bg.png') }}')">
                                <h3 class="text-white fw-semibold px-9 mt-10 mb-6">
                                    Notifications <span class="fs-8 opacity-75 ps-3">24 reports</span>
                                </h3>

                                <ul class="nav nav-line-tabs nav-line-tabs-2x nav-stretch fw-semibold px-9">
                                    <li class="nav-item">
                                        <a class="nav-link text-white opacity-75 opacity-state-100 pb-4" data-bs-toggle="tab" href="#kt_topbar_notifications_1">Alerts</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white opacity-75 opacity-state-100 pb-4 active" data-bs-toggle="tab" href="#kt_topbar_notifications_2">Updates</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white opacity-75 opacity-state-100 pb-4" data-bs-toggle="tab" href="#kt_topbar_notifications_3">Logs</a>
                                    </li>
                                </ul>
                            </div>
                            <!--end::Heading-->

                            <div class="tab-content">
                                <!-- Vos panneaux d'onglets ici -->
                                <div class="text-center px-4 py-10">
                                    <img class="mw-100 mh-200px" alt="image"
                                         src="{{ asset('assets/media/illustrations/dozzy-1/1.png') }}">
                                    <p class="text-muted mt-5">Aucune notification pour le moment</p>
                                </div>
                            </div>
                        </div>
                        <!--end::Menu-->
                    </div>
                    <!--end::Notifications-->

                    <!--begin::Quick links-->
                    <div class="d-flex align-items-center ms-2 ms-lg-3">
                        <div class="btn btn-icon btn-custom btn-active-light w-35px h-35px w-md-40px h-md-40px"
                             data-kt-menu-trigger="{default: 'click', lg: 'hover'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
                            <i class="ki-duotone ki-element-11 fs-1"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span></i>
                        </div>

                        <!--begin::Menu-->
                        <div class="menu menu-sub menu-sub-dropdown menu-column w-250px w-lg-325px" data-kt-menu="true">
                            <div class="d-flex flex-column flex-center bgi-no-repeat rounded-top px-9 py-10"
                                 style="background-image:url('{{ asset('assets/media/patterns/header-bg.png') }}')">
                                <h3 class="text-white fw-semibold mb-3">Accès rapide</h3>
                                <span class="badge bg-primary text-inverse-primary py-2 px-3">Actions rapides</span>
                            </div>

                            <!--begin::Row-->
                            <div class="row g-0">
                                <!--begin::Col - Nouvelle offre-->
                                <div class="col-6">
                                    <a href="{{ path('app_offre_new') }}" class="d-flex flex-column flex-center h-100 p-6 bg-hover-light border-end border-bottom">
                                        <i class="ki-duotone ki-plus-square fs-3x text-primary mb-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                            <span class="path3"></span>
                                        </i>
                                        <span class="fs-5 fw-semibold text-gray-800 mb-0">Nouvelle offre</span>
                                    </a>
                                </div>
                                <!--end::Col-->

                                <!--begin::Col - Nouvel événement-->
                                <div class="col-6">
                                    <a href="{{ path('app_evenement_new') }}" class="d-flex flex-column flex-center h-100 p-6 bg-hover-light border-bottom">
                                        <i class="ki-duotone ki-calendar-add fs-3x text-primary mb-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                        </i>
                                        <span class="fs-5 fw-semibold text-gray-800 mb-0">Nouvel événement</span>
                                    </a>
                                </div>
                                <!--end::Col-->

                                <!--begin::Col - Nouveau canal-->
                                <div class="col-6">
                                    <a href="{{ path('app_canal_new') }}" class="d-flex flex-column flex-center h-100 p-6 bg-hover-light">
                                        <i class="ki-duotone ki-message-text fs-3x text-primary mb-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                            <span class="path3"></span>
                                        </i>
                                        <span class="fs-5 fw-semibold text-gray-800 mb-0">Nouveau canal</span>
                                    </a>
                                </div>
                                <!--end::Col-->
                            </div>
                            <!--end::Row-->
                        </div>
                        <!--end::Menu-->
                    </div>
                    <!--end::Quick links-->

                    <!--begin::Theme mode-->
                    <div class="d-flex align-items-center ms-2 ms-lg-3">
                        <a href="#" class="btn btn-icon btn-custom btn-active-light w-35px h-35px w-md-40px h-md-40px"
                           data-kt-menu-trigger="{default:'click', lg: 'hover'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
                            <i class="ki-duotone ki-night-day theme-light-show fs-1"><span class="path1"></span><span class="path2"></span></i>
                            <i class="ki-duotone ki-moon theme-dark-show fs-1"><span class="path1"></span><span class="path2"></span></i>
                        </a>
                        {# Menu thème - garde le JS existant #}
                    </div>
                    <!--end::Theme mode-->

                    <!--begin::User-->
                    <div class="d-flex align-items-center ms-2 ms-lg-3" id="kt_header_user_menu_toggle">
                        <div class="btn btn-custom btn-active-light cursor-pointer"
                             data-kt-menu-trigger="{default: 'click', lg: 'hover'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
                            <i class="ki-duotone ki-user fs-2 me-2">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                            <span class="fw-semibold">Mon compte</span>
                        </div>

                        <!--begin::User account menu-->
                        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-color fw-semibold py-4 fs-6 w-275px" data-kt-menu="true">
                            {% if app.user %}
                                <div class="menu-item px-3">
                                    <div class="menu-content d-flex align-items-center px-3">
                                        <div class="symbol symbol-50px symbol-circle me-5 bg-light-primary">
                                            <span class="symbol-label fs-2 fw-bold text-primary">
                                                {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                                            </span>
                                        </div>
                                        <div class="d-flex flex-column">
                                            <div class="fw-bold d-flex align-items-center fs-5">
                                                {{ app.user.nom }} {{ app.user.prenom }}
                                                {% if 'ROLE_PARTENAIRE' in app.user.roles %}
                                                    <span class="badge badge-light-success fw-bold fs-8 px-2 py-1 ms-2">Partenaire</span>
                                                {% endif %}
                                            </div>
                                            <a href="{{ path('app_profile') }}" class="fw-semibold text-muted text-hover-primary fs-7">{{ app.user.email }}</a>
                                            {% if app.user.refEntreprise %}
                                                <div class="text-muted fs-8 mt-1">
                                                    <i class="ki-duotone ki-briefcase fs-8">
                                                        <span class="path1"></span>
                                                        <span class="path2"></span>
                                                    </i>
                                                    {{ app.user.refEntreprise.nom }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                <div class="separator my-2"></div>

                                <div class="menu-item px-3">
                                    <a href="{{ path('app_profile') }}" class="menu-link d-flex px-5">
                                        <i class="ki-duotone ki-profile-user fs-2 me-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                            <span class="path3"></span>
                                            <span class="path4"></span>
                                        </i>
                                        Mon profil
                                    </a>
                                </div>

                                <div class="menu-item px-3">
                                    <a href="{{ path('app_candidature_index') }}" class="menu-link d-flex px-5">
                                        <i class="ki-duotone ki-document fs-2 me-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                        </i>
                                        Mes candidatures
                                    </a>
                                </div>

                                <div class="menu-item px-3">
                                    <a href="{{ path('app_inscription_index') }}" class="menu-link d-flex px-5">
                                        <i class="ki-duotone ki-notepad fs-2 me-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                        </i>
                                        Mes inscriptions
                                    </a>
                                </div>

                                <div class="separator my-2"></div>

                                <div class="menu-item px-3">
                                    <a href="{{ path('app_logout') }}" class="menu-link d-flex px-5"
                                       onclick="event.preventDefault(); document.getElementById('logout-form').submit();">
                                        <i class="ki-duotone ki-exit-right fs-2 me-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                        </i>
                                        Déconnexion
                                    </a>

                                    <form id="logout-form" action="{{ path('app_logout') }}" method="POST" class="d-none">
                                        {{ csrf_token('logout')|raw }}
                                    </form>
                                </div>
                            {% else %}
                                <div class="menu-item px-3">
                                    <a href="{{ path('app_login') }}" class="menu-link d-flex px-5">
                                        <i class="ki-duotone ki-entrance-left fs-2 me-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                        </i>
                                        Se connecter
                                    </a>
                                </div>
                                <div class="menu-item px-3">
                                    <a href="{{ path('app_register') }}" class="menu-link d-flex px-5">
                                        <i class="ki-duotone ki-user-tick fs-2 me-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                            <span class="path3"></span>
                                        </i>
                                        S'inscrire
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                        <!--end::User account menu-->
                    </div>
                    <!--end::User-->

                </div>
                <!--end::Toolbar wrapper-->
            </div>
            <!--end::Topbar-->
        </div>
        <!--end::Wrapper-->
    </div>
    <!--end::Container-->
</div>
