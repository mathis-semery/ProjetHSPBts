{% extends 'base.html.twig' %}

{% block title %}GDH – Générale des Hôpitaux{% endblock %}

{% block stylesheets %}
    <!-- Leaflet CSS pour la carte -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Styles spécifiques à la page home -->
    <link rel="stylesheet" href="{{ asset('assets/css/home.css') }}">
{% endblock %}

{% block content_wrapper %}
{# Layout full-width pour la page home sans card wrapper #}
<div class="container-xxl py-8">{# Ne pas fermer cette div ici, elle sera fermée à la fin #}
<!-- Hero Section -->
<section class="hero-section text-center">
    <div class="container">
        <h1 class="hero-title">Bienvenue dans l'écosystème GDH</h1>
        <p class="hero-subtitle">Premier groupe de cliniques et hôpitaux privés en France — 70 ans d'expertise au service de la santé</p>
        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
            <a href="#" class="btn btn-light btn-lg px-5">
                <i class="ki-duotone ki-user fs-2"><span class="path1"></span><span class="path2"></span></i>
                Étudiant
            </a>
            <a href="#" class="btn btn-success btn-lg px-5">
                <i class="ki-duotone ki-office-bag fs-2"><span class="path1"></span><span class="path2"></span></i>
                Entreprise
            </a>
            <a href="#" class="btn btn-info btn-lg px-5">
                <i class="ki-duotone ki-heart-pulse fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                Médecin
            </a>
        </div>
    </div>
</section>

<!-- Présentation du groupe GDH -->
<section class="py-6">
    <h2 class="section-title text-center">Le groupe GDH</h2>
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <p class="fs-5 text-gray-800">
                Créée en <strong>1954</strong> à Paris, la <strong>Générale des Hôpitaux (GDH)</strong> est le <strong>premier groupe privé de santé en France</strong>.
            </p>
            <p class="text-gray-700">
                Fort de <strong>70 ans d'expérience</strong>, GDH rassemble aujourd'hui <strong>9 hôpitaux</strong> répartis sur tout le territoire.
            </p>
            <p class="text-gray-700">
                L'un de ses établissements phares, l'<strong>Hôpital Sud Paris (HSP)</strong>, inauguré en <strong>1995</strong> à Marreuil-sur-Seine, dispose de :
            </p>
            <ul class="list-unstyled">
                <li class="d-flex align-items-start mb-3">
                    <i class="ki-duotone ki-check fs-2 text-success me-3">
                        <span class="path1"></span>
                        <span class="path2"></span>
                    </i>
                    <span class="text-gray-700"><strong>90 praticiens</strong></span>
                </li>
                <li class="d-flex align-items-start mb-3">
                    <i class="ki-duotone ki-check fs-2 text-success me-3">
                        <span class="path1"></span>
                        <span class="path2"></span>
                    </i>
                    <span class="text-gray-700"><strong>289 lits</strong></span>
                </li>
                <li class="d-flex align-items-start mb-3">
                    <i class="ki-duotone ki-check fs-2 text-success me-3">
                        <span class="path1"></span>
                        <span class="path2"></span>
                    </i>
                    <span class="text-gray-700"><strong>6 pôles médicaux</strong> : chirurgie, médecine, cancérologie, maternité, imagerie médicale, urgences 24h/24</span>
                </li>
            </ul>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <img src="{{ asset('assets/media/P_20180602_103845.jpg') }}"
                         alt="Hôpital Sud Paris – Façade"
                         class="w-100 h-100 rounded"
                         style="object-fit: cover; min-height: 350px;"
                         onerror="this.parentElement.innerHTML='<div class=\'d-flex align-items-center justify-content-center text-muted\' style=\'min-height: 350px;\'>Image non disponible</div>'">
                </div>
                <div class="card-footer text-center bg-light">
                    <small class="text-muted">Hôpital Sud Paris (HSP) – Inauguré en 1995</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Objectifs de la plateforme -->
<section class="py-6">
    <h2 class="section-title text-center">Objectif de cette plateforme</h2>
    <p class="text-center text-gray-700 mb-5">Renforcer les liens entre trois acteurs clés de l'écosystème santé :</p>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="icon-card">
                <div class="card-icon bg-success">
                    <i class="ki-duotone ki-heart-pulse fs-2x">
                        <span class="path1"></span>
                        <span class="path2"></span>
                        <span class="path3"></span>
                    </i>
                </div>
                <h5 class="fw-bold text-gray-900">Médecins du groupe</h5>
                <p class="text-gray-600">
                    Maintenir le contact, organiser des événements, participer à l'encadrement des futurs professionnels.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="icon-card">
                <div class="card-icon bg-primary">
                    <i class="ki-duotone ki-user fs-2x">
                        <span class="path1"></span>
                        <span class="path2"></span>
                    </i>
                </div>
                <h5 class="fw-bold text-gray-900">Étudiants en médecine</h5>
                <p class="text-gray-600">
                    Accès à des stages, alternances, emplois, événements et mentorat dès la formation.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="icon-card">
                <div class="card-icon bg-info">
                    <i class="ki-duotone ki-office-bag fs-2x">
                        <span class="path1"></span>
                        <span class="path2"></span>
                    </i>
                </div>
                <h5 class="fw-bold text-gray-900">Entreprises partenaires</h5>
                <p class="text-gray-600">
                    Recruter des talents, co-organiser des événements, valoriser leurs innovations.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Réseau national (9 hôpitaux) -->
<section class="py-6">
    <h2 class="section-title text-center">Notre réseau national</h2>
    <p class="text-center text-gray-700 mb-5">GDH compte <strong>9 hôpitaux</strong> stratégiquement situés en France métropolitaine :</p>

    <!-- Card contenant la carte et les boutons -->
    <div class="card hospital-map-card shadow-sm">
        <!-- Carte interactive -->
        <div id="map"></div>

        <!-- Séparateur -->
        <div class="map-section-header">
            <h6 class="fw-semibold">
                <i class="ki-duotone ki-geolocation fs-2 me-2">
                    <span class="path1"></span>
                    <span class="path2"></span>
                </i>
                Sélectionnez un établissement
            </h6>
        </div>

        <!-- Boutons de navigation organisés en grille -->
        <div class="card-body p-4">
            <div class="row g-2">
                <div class="col-md-4">
                    <button class="btn btn-outline-primary btn-hospital w-100 text-start" data-hospital="0">
                        <i class="ki-duotone ki-hospital fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                        HSP - Hôpital Sud Paris
                    </button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary btn-hospital w-100 text-start" data-hospital="1">
                        <i class="ki-duotone ki-hospital fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                        HNP - Hôpital Nord Paris
                    </button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary btn-hospital w-100 text-start" data-hospital="2">
                        <i class="ki-duotone ki-hospital fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                        Clinique Océane
                    </button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary btn-hospital w-100 text-start" data-hospital="3">
                        <i class="ki-duotone ki-hospital fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                        Centre Hospitalier Lyon
                    </button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary btn-hospital w-100 text-start" data-hospital="4">
                        <i class="ki-duotone ki-hospital fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                        Clinique Méditerranée
                    </button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary btn-hospital w-100 text-start" data-hospital="5">
                        <i class="ki-duotone ki-hospital fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                        Hôpital des Alpes
                    </button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary btn-hospital w-100 text-start" data-hospital="6">
                        <i class="ki-duotone ki-hospital fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                        Centre de Santé Bretagne
                    </button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary btn-hospital w-100 text-start" data-hospital="7">
                        <i class="ki-duotone ki-hospital fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                        Hôpital du Grand Est
                    </button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary btn-hospital w-100 text-start" data-hospital="8">
                        <i class="ki-duotone ki-hospital fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                        Clinique Aquitaine
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA finale -->
<section class="cta-section">
    <div class="container">
        <h2>Rejoignez la communauté GDH</h2>
        <p>Ensemble, construisons une santé connectée, innovante et humaine.</p>
    </div>
</section>

</div>{# Fermeture du container-xxl #}
{% endblock %}

{% block javascripts %}
<!-- Leaflet JS pour la carte -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Données des 9 hôpitaux du groupe GDH
    const hospitals = [
        {
            name: "HSP - Hôpital Sud Paris",
            address: "1 Avenue de la Santé, 77000 Marreuil-sur-Seine",
            phone: "01 64 71 50 00",
            lat: 48.534,
            lng: 2.950,
            specialties: "Chirurgie • Médecine • Maternité • Urgences 24/7"
        },
        {
            name: "HNP - Hôpital Nord Paris",
            address: "85 Boulevard Victor Hugo, 93400 Saint-Ouen",
            phone: "01 49 18 20 00",
            lat: 48.912,
            lng: 2.333,
            specialties: "Cancérologie • Cardiologie • Neurologie"
        },
        {
            name: "Clinique Océane",
            address: "42 Rue de la Mer, 35400 Saint-Malo",
            phone: "02 99 81 60 00",
            lat: 48.649,
            lng: -2.005,
            specialties: "Chirurgie ambulatoire • Imagerie • Rééducation"
        },
        {
            name: "Centre Hospitalier Lyon Est",
            address: "156 Avenue Lacassagne, 69003 Lyon",
            phone: "04 72 11 77 11",
            lat: 45.753,
            lng: 4.878,
            specialties: "Orthopédie • Rhumatologie • Médecine sportive"
        },
        {
            name: "Clinique Méditerranée",
            address: "8 Corniche Kennedy, 13007 Marseille",
            phone: "04 91 59 12 00",
            lat: 43.282,
            lng: 5.358,
            specialties: "Chirurgie esthétique • Dermatologie • Ophtalmologie"
        },
        {
            name: "Hôpital des Alpes",
            address: "22 Avenue Jean Jaurès, 38000 Grenoble",
            phone: "04 76 46 50 50",
            lat: 45.188,
            lng: 5.715,
            specialties: "Traumatologie • Médecine de montagne • Urgences"
        },
        {
            name: "Centre de Santé Bretagne",
            address: "15 Rue de Rennes, 29200 Brest",
            phone: "02 98 34 70 00",
            lat: 48.390,
            lng: -4.486,
            specialties: "Médecine générale • Pédiatrie • Gériatrie"
        },
        {
            name: "Hôpital du Grand Est",
            address: "30 Boulevard de l'Europe, 67000 Strasbourg",
            phone: "03 88 35 50 00",
            lat: 48.583,
            lng: 7.745,
            specialties: "Cardiologie • Pneumologie • Néphrologie"
        },
        {
            name: "Clinique Aquitaine",
            address: "77 Cours de l'Intendance, 33000 Bordeaux",
            phone: "05 56 90 80 00",
            lat: 44.841,
            lng: -0.574,
            specialties: "Oncologie • Radiothérapie • Soins palliatifs"
        }
    ];

    // Initialisation de la carte centrée sur la France
    const map = L.map('map', {
        center: [46.603354, 1.888334],
        zoom: 6,
        scrollWheelZoom: false,
        zoomControl: true
    });

    // Ajout de la couche de tuiles OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 19,
        minZoom: 5
    }).addTo(map);

    // Forcer le recalcul de la taille après un court délai
    setTimeout(function() {
        map.invalidateSize();
    }, 100);

    // Icône personnalisée pour les hôpitaux (SVG simple)
    const hospitalIcon = L.divIcon({
        html: '<div style="width: 36px; height: 36px; background: #1B84FF; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(27, 132, 255, 0.4); border: 3px solid white;"><svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 11h-4v4h-4v-4H6v-4h4V6h4v4h4v4z"/></svg></div>',
        iconSize: [36, 36],
        iconAnchor: [18, 36],
        popupAnchor: [0, -36],
        className: 'hospital-marker'
    });

    // Tableau pour stocker les marqueurs
    const markers = [];

    // Ajout des marqueurs pour chaque hôpital
    hospitals.forEach((hospital, index) => {
        const marker = L.marker([hospital.lat, hospital.lng], { icon: hospitalIcon })
            .bindPopup(`
                <div style="min-width: 250px; padding: 0.5rem;">
                    <h6 style="color: #1B84FF; font-weight: 700; margin-bottom: 0.75rem; font-size: 1rem;">${hospital.name}</h6>
                    <p style="margin-bottom: 0.5rem; font-size: 0.875rem; color: #3F4254;">
                        <strong>📍</strong> ${hospital.address}
                    </p>
                    <p style="margin-bottom: 0.5rem; font-size: 0.875rem; color: #3F4254;">
                        <strong>📞</strong> ${hospital.phone}
                    </p>
                    <p style="margin-bottom: 0; font-size: 0.875rem; color: #7E8299;">
                        <strong>🏥</strong> ${hospital.specialties}
                    </p>
                </div>
            `)
            .addTo(map);
        markers.push(marker);
    });

    // Gestion des boutons de navigation
    document.querySelectorAll('.btn-hospital').forEach((button, index) => {
        button.addEventListener('click', function() {
            const hospitalIndex = parseInt(this.getAttribute('data-hospital'));
            const hospital = hospitals[hospitalIndex];

            // Centrer la carte sur l'hôpital sélectionné
            map.setView([hospital.lat, hospital.lng], 13);

            // Ouvrir le popup du marqueur
            markers[hospitalIndex].openPopup();

            // Animation du bouton
            document.querySelectorAll('.btn-hospital').forEach(btn => {
                btn.classList.remove('active');
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-outline-primary');
            });
            this.classList.remove('btn-outline-primary');
            this.classList.add('btn-primary');
            this.classList.add('active');
        });
    });
}); // Fin du DOMContentLoaded
</script>
{% endblock %}
