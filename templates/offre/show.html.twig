{% extends 'base.html.twig' %}

{% block title %}{{ offre.titre }} - Offres d'emploi{% endblock %}

{% block body %}
    <div class="container py-10">

        <!-- Navigation -->
        <div class="mb-6">
            <a href="{{ path('app_offre_index') }}" class="btn btn-light-secondary">
                <i class="ki-duotone ki-left fs-2"></i>
                Retour aux offres
            </a>
        </div>

        <div class="row g-6">
            <!-- Colonne principale (Détails de l'offre) -->
            <div class="col-lg-8">
                <div class="card shadow-sm mb-6">
                    <div class="card-header border-0 pt-6">
                        <div class="d-flex justify-content-between align-items-start w-100">
                            <div class="flex-grow-1">
                                <h1 class="fw-bold text-dark mb-3">{{ offre.titre }}</h1>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <span class="badge badge-{{ offre.etat ? 'success' : 'secondary' }} fs-6">
                                        {{ offre.etat ? 'Ouverte' : 'Fermée' }}
                                    </span>
                                    <span class="badge badge-light-primary fs-6">{{ offre.type }}</span>
                                    {% if offre.salaire %}
                                        <span class="badge badge-light-success fs-6">{{ offre.salaire }}€ / an</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <!-- Description -->
                        <div class="mb-8">
                            <h3 class="fs-2 fw-bold text-dark mb-4">
                                <i class="ki-duotone ki-information-5 fs-2 text-primary me-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                </i>
                                Description
                            </h3>
                            <p class="text-gray-800 fs-5 lh-lg">{{ offre.description }}</p>
                        </div>

                        <!-- Missions -->
                        {% if offre.mission %}
                            <div class="mb-8">
                                <h3 class="fs-2 fw-bold text-dark mb-4">
                                    <i class="ki-duotone ki-notepad fs-2 text-primary me-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                    </i>
                                    Missions
                                </h3>
                                <p class="text-gray-800 fs-5 lh-lg">{{ offre.mission }}</p>
                            </div>
                        {% endif %}

                        <!-- Actions pour l'auteur -->
                        {% if (is_granted('ROLE_ADMIN') or is_granted('ROLE_PARTENAIRE')) and offre.auteur == app.user %}
                            <div class="separator my-6"></div>
                            <div class="d-flex gap-3">
                                <a href="{{ path('app_offre_edit', {'id': offre.id}) }}" class="btn btn-light-primary">
                                    <i class="ki-duotone ki-pencil fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                    Modifier l'offre
                                </a>
                                {{ include('offre/_delete_form.html.twig') }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Colonne latérale (Candidature) -->
            <div class="col-lg-4">
                <!-- Informations complémentaires -->
                <div class="card shadow-sm mb-6">
                    <div class="card-body">
                        <h3 class="fs-3 fw-bold text-dark mb-5">Informations</h3>

                        <!-- Entreprise -->
                        {% if offre.auteur.refEntreprise %}
                            <div class="mb-5">
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-office-bag fs-2 text-primary me-3">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                    </i>
                                    <div>
                                        <div class="text-gray-500 fs-7">Entreprise</div>
                                        <div class="text-dark fw-bold">
                                            {{ offre.auteur.refEntreprise.nom }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Auteur -->
                        <div class="mb-5">
                            <div class="d-flex align-items-center">
                                <i class="ki-duotone ki-profile-circle fs-2 text-primary me-3">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                </i>
                                <div>
                                    <div class="text-gray-500 fs-7">Publié par</div>
                                    <div class="text-dark fw-bold">
                                        {{ offre.auteur.prenom }} {{ offre.auteur.nom }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Type de contrat -->
                        <div class="mb-5">
                            <div class="d-flex align-items-center">
                                <i class="ki-duotone ki-briefcase fs-2 text-primary me-3">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                                <div>
                                    <div class="text-gray-500 fs-7">Type de contrat</div>
                                    <div class="text-dark fw-bold">{{ offre.type }}</div>
                                </div>
                            </div>
                        </div>

                        <!-- Salaire -->
                        {% if offre.salaire %}
                            <div class="mb-5">
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-euro fs-2 text-primary me-3">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                    </i>
                                    <div>
                                        <div class="text-gray-500 fs-7">Salaire</div>
                                        <div class="text-dark fw-bold">{{ offre.salaire }}€ / an</div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Nombre de candidatures -->
                        <div class="mb-0">
                            <div class="d-flex align-items-center">
                                <i class="ki-duotone ki-people fs-2 text-primary me-3">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                    <span class="path4"></span>
                                    <span class="path5"></span>
                                </i>
                                <div class="flex-grow-1">
                                    <div class="text-gray-500 fs-7">Candidatures</div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-dark fw-bold">{{ offre.candidatures|length }}</span>
                                        {% if peutVoirCandidatures and candidaturesEnAttente > 0 %}
                                            <span class="badge badge-warning badge-circle pulse pulse-warning" title="{{ candidaturesEnAttente }} nouvelle(s) candidature(s)">
                                                {{ candidaturesEnAttente }}
                                                <span class="pulse-ring"></span>
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Formulaire de candidature -->
                {% if offre.etat and app.user and offre.auteur != app.user %}
                    <div class="card shadow-sm border-primary">
                        <div class="card-header bg-primary">
                            <h3 class="card-title text-white fw-bold">
                                <i class="ki-duotone ki-send fs-2 text-white me-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                                Postuler à cette offre
                            </h3>
                        </div>
                        <div class="card-body">
                            {% if dejaCandidature %}
                                <div class="alert alert-success d-flex align-items-center">
                                    <i class="ki-duotone ki-check-circle fs-2x text-success me-3">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                    <div>
                                        <h4 class="mb-1 text-success">Candidature envoyée</h4>
                                        <span>Vous avez déjà postulé à cette offre.</span>
                                    </div>
                                </div>
                            {% else %}
                                <form method="post" action="{{ path('app_offre_postuler', {'id': offre.id}) }}">
                                    <div class="mb-5">
                                        <label for="lettre_motivation" class="form-label fw-bold required">Lettre de motivation</label>
                                        <textarea
                                            id="lettre_motivation"
                                            name="lettre_motivation"
                                            class="form-control"
                                            rows="8"
                                            placeholder="Expliquez votre motivation et pourquoi vous êtes le candidat idéal pour ce poste..."
                                            required></textarea>
                                        <div class="form-text">Minimum 50 caractères</div>
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="ki-duotone ki-send fs-2">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                        </i>
                                        Envoyer ma candidature
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                {% elseif not offre.etat %}
                    <div class="alert alert-warning d-flex align-items-center">
                        <i class="ki-duotone ki-information-2 fs-2x text-warning me-3">
                            <span class="path1"></span>
                            <span class="path2"></span>
                            <span class="path3"></span>
                        </i>
                        <div>
                            <h4 class="mb-1 text-warning">Offre fermée</h4>
                            <span>Cette offre n'accepte plus de candidatures.</span>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Section des candidatures (visible uniquement pour l'entreprise) -->
        {% if peutVoirCandidatures %}
            <div class="row mt-6">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header border-0 pt-6">
                            <h3 class="card-title align-items-start flex-column">
                                <div class="d-flex align-items-center gap-3 mb-1">
                                    <span class="card-label fw-bold fs-2">Candidatures</span>
                                    {% if candidaturesEnAttente > 0 %}
                                        <span class="badge badge-warning pulse pulse-warning">
                                            {{ candidaturesEnAttente }} en attente
                                            <span class="pulse-ring"></span>
                                        </span>
                                    {% endif %}
                                </div>
                                <span class="text-muted fw-semibold fs-7">{{ offre.candidatures|length }} candidature(s) reçue(s)</span>
                            </h3>
                        </div>
                        <div class="card-body pt-0">
                            {% if offre.candidatures|length > 0 %}
                            <div class="table-responsive">
                                <table class="table table-row-bordered table-row-gray-100 align-middle gs-0 gy-3">
                                    <thead>
                                        <tr class="fw-bold text-muted">
                                            <th class="min-w-150px">Candidat</th>
                                            <th class="min-w-120px">Email</th>
                                            <th class="min-w-120px">Formation</th>
                                            <th class="min-w-120px">Métier</th>
                                            <th class="min-w-100px">Statut</th>
                                            <th class="min-w-200px text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for candidature in offre.candidatures %}
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="symbol symbol-45px symbol-circle me-3 bg-light-primary">
                                                            <span class="symbol-label fs-6 fw-bold text-primary">
                                                                {{ candidature.refUser.prenom|first|upper }}{{ candidature.refUser.nom|first|upper }}
                                                            </span>
                                                        </div>
                                                        <div class="d-flex flex-column">
                                                            <span class="text-dark fw-bold text-hover-primary fs-6">
                                                                {{ candidature.refUser.nom }} {{ candidature.refUser.prenom }}
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="text-muted fw-semibold text-muted d-block fs-7">
                                                        {{ candidature.refUser.email }}
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="text-dark fw-semibold d-block fs-7">
                                                        {{ candidature.refUser.formation ?? 'Non renseigné' }}
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="text-dark fw-semibold d-block fs-7">
                                                        {{ candidature.refUser.metier }}
                                                    </span>
                                                </td>
                                                <td>
                                                    {% if candidature.etat is null %}
                                                        <span class="badge badge-light-warning">En attente</span>
                                                    {% elseif candidature.etat %}
                                                        <span class="badge badge-light-success">Acceptée</span>
                                                    {% else %}
                                                        <span class="badge badge-light-danger">Refusée</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-end">
                                                    <a href="#" class="btn btn-sm btn-light-primary me-2" data-bs-toggle="modal" data-bs-target="#modalLettre{{ candidature.id }}">
                                                        <i class="ki-duotone ki-eye fs-4">
                                                            <span class="path1"></span>
                                                            <span class="path2"></span>
                                                            <span class="path3"></span>
                                                        </i>
                                                        Voir lettre
                                                    </a>
                                                    <a href="{{ path('app_profile', {id: candidature.refUser.id}) }}" class="btn btn-sm btn-light-info me-2">
                                                        <i class="ki-duotone ki-profile-user fs-4">
                                                            <span class="path1"></span>
                                                            <span class="path2"></span>
                                                            <span class="path3"></span>
                                                        </i>
                                                        Profil
                                                    </a>
                                                    {% if candidature.etat is null %}
                                                        <a href="{{ path('app_candidature_accepter', {id: candidature.id}) }}" class="btn btn-sm btn-light-success me-2">
                                                            <i class="ki-duotone ki-check fs-4">
                                                                <span class="path1"></span>
                                                                <span class="path2"></span>
                                                            </i>
                                                            Accepter
                                                        </a>
                                                        <a href="{{ path('app_candidature_refuser', {id: candidature.id}) }}" class="btn btn-sm btn-light-danger">
                                                            <i class="ki-duotone ki-cross fs-4">
                                                                <span class="path1"></span>
                                                                <span class="path2"></span>
                                                            </i>
                                                            Refuser
                                                        </a>
                                                    {% endif %}
                                                </td>
                                            </tr>

                                            <!-- Modal pour voir la lettre de motivation -->
                                            <div class="modal fade" id="modalLettre{{ candidature.id }}" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h3 class="modal-title">Lettre de motivation</h3>
                                                            <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal">
                                                                <i class="ki-duotone ki-cross fs-1">
                                                                    <span class="path1"></span>
                                                                    <span class="path2"></span>
                                                                </i>
                                                            </div>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-5">
                                                                <h4 class="fw-bold mb-3">Candidat</h4>
                                                                <p class="text-muted">{{ candidature.refUser.nom }} {{ candidature.refUser.prenom }}</p>
                                                            </div>
                                                            <div>
                                                                <h4 class="fw-bold mb-3">Message</h4>
                                                                <div class="text-gray-800 fs-6 lh-lg">
                                                                    {{ candidature.lettre|nl2br }}
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Fermer</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            {% else %}
                                <div class="text-center py-10">
                                    <i class="ki-duotone ki-file-deleted fs-5x text-muted mb-5">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                    <h3 class="text-gray-600 fw-semibold mb-2">Aucune candidature</h3>
                                    <p class="text-muted fs-6">Il n'y a pas encore de candidatures pour cette offre.</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}
