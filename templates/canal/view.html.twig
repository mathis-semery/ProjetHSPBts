{% extends 'base.html.twig' %}

{% block title %}{{ canal.nom }} - Chat{% endblock %}

{% block body %}
    <div class="container py-10">
        <div class="card mb-10">
            <div class="card-body p-10">
                <h1 class="fs-2hx fw-bold text-dark mb-4">{{ canal.nom }}</h1>
                <p class="fs-5 text-gray-600 mb-0">{{ canal.description }}</p>
            </div>
        </div>

        {% if app.user %}
            <div class="card mb-10">
                <div class="card-header border-0 pt-6">
                    <h3 class="card-title fw-bold fs-3 mb-0">Créer un nouveau post</h3>
                </div>
                <div class="card-body pt-0">
                    {{ form_start(formPost) }}
                    <div class="mb-5">
                        {{ form_row(formPost.titre, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Titre du post'}}) }}
                    </div>
                    <div class="mb-5">
                        {{ form_row(formPost.texte, {'attr': {'class': 'form-control form-control-lg', 'rows': '4', 'placeholder': 'Écrivez votre message...'}}) }}
                    </div>
                    <button class="btn btn-primary">Publier</button>
                    {{ form_end(formPost) }}
                </div>
            </div>
        {% endif %}

        {% for post in canal.posts %}
            <div class="card mb-8">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-1">{{ post.titre ?? 'Post' }}</h4>
                        <span class="text-muted fs-7">Par {{ post.refUser.userIdentifier }}</span>
                    </div>
                    <div class="d-flex gap-2">
                        {% if app.user and (app.user == post.refUser or is_granted('ROLE_ADMIN')) %}
                            <button type="button"
                                    class="btn btn-sm btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deletePostModal{{ post.id }}">
                                Supprimer
                            </button>
                        {% endif %}
                    </div>
                </div>

                <div class="card-body">
                    <p class="text-gray-800 fs-5 mb-6">{{ post.texte }}</p>

                    {% for reponse in post.reponses %}
                        <div class="d-flex align-items-start mb-4 ps-4 border-start">
                            <div>
                                <div class="fw-semibold text-dark">{{ reponse.refUser.userIdentifier }}</div>
                                <div class="text-gray-700">{{ reponse.texte }}</div>
                                <div class="text-muted fs-8">{{ reponse.dateHeure|date('d/m/Y H:i') }}</div>
                            </div>
                            {% if app.user and (app.user == reponse.refUser or is_granted('ROLE_ADMIN')) %}
                                <button type="button"
                                        class="btn btn-sm btn-danger ms-3"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteReponseModal{{ reponse.id }}">
                                    Supprimer
                                </button>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="text-muted fst-italic">Aucune réponse pour ce post.</p>
                    {% endfor %}

                    {% if app.user %}
                        <form method="post" class="d-flex flex-column gap-3 mt-3">
                            <textarea name="texte" rows="2" class="form-control form-control-sm" placeholder="Écrire une réponse..." required></textarea>
                            <input type="hidden" name="post_id" value="{{ post.id }}">
                            <button type="submit" class="btn btn-sm btn-light-primary align-self-end">Répondre</button>
                        </form>
                    {% endif %}
                </div>
            </div>

            {# Modal de confirmation pour post #}
            <div class="modal fade" id="deletePostModal{{ post.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title text-danger">Supprimer ce post ?</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p class="fs-5 fw-semibold text-gray-700">
                                Cette action est <span class="text-danger fw-bold">définitive</span>.<br>
                                Voulez-vous vraiment supprimer le post :
                            </p>
                            <p class="fs-4 fw-bold text-dark mb-0">“{{ post.titre }}”</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                            <form method="post" action="{{ path('app_post_delete', {'id': post.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                <button class="btn btn-danger">Confirmer la suppression</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            {# Modals pour chaque réponse #}
            {% for reponse in post.reponses %}
                <div class="modal fade" id="deleteReponseModal{{ reponse.id }}" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title text-danger">Supprimer cette réponse ?</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="fs-5 fw-semibold text-gray-700">
                                    Cette action est <span class="text-danger fw-bold">définitive</span>.<br>
                                    Voulez-vous vraiment supprimer cette réponse ?
                                </p>
                                <p class="fs-6 text-dark mb-0">{{ reponse.texte|length > 100 ? reponse.texte|slice(0,100) ~ '...' : reponse.texte }}</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                                <form method="post" action="{{ path('app_reponse_delete', {'id': reponse.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reponse.id) }}">
                                    <button class="btn btn-danger">Confirmer la suppression</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endblock %}
