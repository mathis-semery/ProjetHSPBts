{% extends 'base.html.twig' %}

{% block title %}Gestion des Entreprises{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.datatables.net/v/bs5/dt-2.1.8/datatables.min.css" rel="stylesheet">
    <style>
        .dt-search input {
            border-radius: 0.475rem !important;
            padding: 0.5rem 1rem;
        }
        .dt-length select {
            border-radius: 0.475rem !important;
            padding: 0.5rem 1rem;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-6">
        <h1 class="h2 mb-0">Gestion des Entreprises</h1>
        <a href="{{ path('app_entreprise_new') }}" class="btn btn-primary">
            <i class="ki-duotone ki-plus fs-2"></i>
            <span class="ms-1">Ajouter une entreprise</span>
        </a>
    </div>

    {% if entreprises is empty %}
        <div class="alert alert-light-primary d-flex align-items-center p-5 mb-0">
            <i class="ki-duotone ki-information fs-2x text-primary me-4"></i>
            <div class="d-flex flex-column">
                <span class="fw-bold fs-6">Aucune entreprise</span>
                <span>Aucune entreprise n’a été créée pour le moment.</span>
            </div>
        </div>
    {% else %}
        <div class="table-responsive">
            <table id="kt_datatable_entreprises" class="table align-middle table-row-dashed fs-6 gy-5">
                <thead>
                <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                    <th class="min-w-50px">ID</th>
                    <th class="min-w-150px">Nom</th>
                    <th class="min-w-200px">Adresse</th>
                    <th class="min-w-200px">Site Web</th>
                    <th class="text-end min-w-125px">Actions</th>
                </tr>
                </thead>
                <tbody class="fw-semibold text-gray-700">
                {% for entreprise in entreprises %}
                    <tr>
                        <td>{{ entreprise.id }}</td>
                        <td><strong>{{ entreprise.nom }}</strong></td>
                        <td>{{ entreprise.adresse ?: '—' }}</td>
                        <td>
                            {% if entreprise.siteWeb %}
                                <a href="{{ entreprise.siteWeb }}" target="_blank" class="text-primary text-hover-underline">
                                    {{ entreprise.siteWeb}}
                                </a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_entreprise_show', {'id': entreprise.id}) }}" class="btn btn-sm btn-outline-info">Voir</a>
                            <a href="{{ path('app_entreprise_edit', {'id': entreprise.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                            <form method="post" action="{{ path('app_entreprise_delete', {'id': entreprise.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette entreprise ? Cette action est irréversible.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entreprise.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.8/datatables.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const table = new DataTable('#kt_datatable_entreprises', {
                responsive: true,
                search: {
                    return: true // Appuyer sur Entrée pour lancer la recherche
                },
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.1.8/i18n/fr-FR.json'
                },
                order: [[0, 'desc']], // Tri par ID décroissant
                columnDefs: [
                    { orderable: true, targets: [0, 1, 2, 3] },
                    { orderable: false, targets: [4] } // Actions non triables
                ]
            });
        });
    </script>
{% endblock %}

