{% extends 'base.html.twig' %}

{% block title %}Modifier le canal{% endblock %}

{% block body %}
    <div class="container py-10">

        <div class="card shadow-sm">
            <div class="card-header border-0 pt-6 pb-0">
                <h2 class="card-title fw-bold fs-2hx text-dark">Modifier le canal</h2>
            </div>

            <div class="card-body py-6">
                {{ form_start(form, {'attr': {'class': 'form'}}) }}

                <div class="mb-7">
                    {{ form_label(form.nom, 'Nom du canal', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control form-control-solid'}}) }}
                    {{ form_errors(form.nom) }}
                </div>

                <div class="mb-7">
                    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control form-control-solid'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="mb-7">
                    {{ form_label(form.ListeAuto, 'Liste automatique (métiers)', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.ListeAuto, {'attr': {'class': 'form-control form-control-solid'}}) }}
                    {{ form_errors(form.ListeAuto) }}
                </div>

                <div class="d-flex justify-content-between">

                    <button type="button"
                            class="btn btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal">
                        Supprimer ce canal
                    </button>

                    <div>
                        <a href="{{ path('app_canal_index') }}" class="btn btn-light me-3">Annuler</a>
                        <button class="btn btn-primary">
                            <i class="ki-duotone ki-check fs-2 me-2"></i>Enregistrer
                        </button>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title text-danger">Supprimer ce canal ?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <p class="fs-5 fw-semibold text-gray-700">
                        Cette action est <span class="text-danger fw-bold">définitive</span>.<br>
                        Voulez-vous vraiment supprimer le canal :
                    </p>
                    <p class="fs-4 fw-bold text-dark mb-0">“{{ canal.nom }}”</p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>

                    <form method="post" action="{{ path('app_canal_edit', {'id': canal.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('edit' ~ canal.id) }}">
                        <button class="btn btn-danger">
                            <i class="ki-duotone ki-trash fs-2 me-1"></i>
                            Confirmer la suppression
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>

{% endblock %}
