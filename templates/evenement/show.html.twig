{% extends 'base.html.twig' %}

{% block title %}{{ evenement.titre }} - Événements{% endblock %}

{% block body %}
    <div class="container py-10">

        <div class="mb-6">
            <a href="{{ path('app_evenement_index') }}" class="btn btn-light-secondary">
                <i class="ki-duotone ki-left fs-2"></i>
                Retour aux événements
            </a>
        </div>

        <div class="row g-6">

            <div class="col-lg-8">
                <div class="card shadow-sm mb-6">
                    <div class="card-header border-0 pt-6">
                        <div class="d-flex justify-content-between align-items-start w-100">
                            <div class="flex-grow-1">
                                <h1 class="fw-bold text-dark mb-3">{{ evenement.titre }}</h1>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <span class="badge badge-light-primary fs-6">{{ evenement.type }}</span>
                                    {% if evenement.nombreDePlace %}
                                        {% if evenement.placesRestantes > 0 %}
                                            <span class="badge badge-light-success fs-6">
                                                {{ evenement.placesRestantes }} place(s) disponible(s)
                                            </span>
                                        {% else %}
                                            <span class="badge badge-light-danger fs-6">Complet</span>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <!-- Description -->
                        <div class="mb-8">
                            <h3 class="fs-2 fw-bold text-dark mb-4">
                                <i class="ki-duotone ki-information-5 fs-2 text-primary me-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                </i>
                                Description
                            </h3>
                            <p class="text-gray-800 fs-5 lh-lg">{{ evenement.description ?: 'Aucune description disponible.' }}</p>
                        </div>

                        <!-- Éléments requis -->
                        {% if evenement.elementRequis %}
                            <div class="mb-8">
                                <h3 class="fs-2 fw-bold text-dark mb-4">
                                    <i class="ki-duotone ki-notepad fs-2 text-primary me-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                    </i>
                                    Éléments requis
                                </h3>
                                <p class="text-gray-800 fs-5 lh-lg">{{ evenement.elementRequis }}</p>
                            </div>
                        {% endif %}

                        <!-- Section Inscription -->
                        <div class="mb-8">
                            <h3 class="fs-2 fw-bold text-dark mb-4">
                                <i class="ki-duotone ki-check-circle fs-2 text-primary me-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                                Inscription
                            </h3>

                            {% set userInscription = null %}
                            {% if app.user %}
                                {% for inscription in evenement.inscriptions %}
                                    {% if inscription.refUser == app.user and inscription.etat %}
                                        {% set userInscription = inscription %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}

                            {% if app.user %}
                                {% if userInscription %}
                                    <div class="alert alert-success d-flex align-items-center mb-4">
                                        <i class="ki-duotone ki-check-circle fs-2x text-success me-4">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                        </i>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold fs-5">Vous êtes inscrit à cet événement</span>
                                            <span class="text-muted">Inscrit le {{ userInscription.date|date('d/m/Y à H:i') }}</span>
                                        </div>
                                    </div>
                                    <form method="post" action="{{ path('app_evenement_unregister', {'id': evenement.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('unregister' ~ evenement.id) }}">
                                        <button type="submit" class="btn btn-danger btn-lg" onclick="return confirm('Êtes-vous sûr de vouloir vous désinscrire de cet événement ?');">
                                            <i class="ki-duotone ki-cross-circle fs-2">
                                                <span class="path1"></span>
                                                <span class="path2"></span>
                                            </i>
                                            <span class="ms-1">Se désinscrire</span>
                                        </button>
                                    </form>
                                {% else %}
                                    {% if evenement.hasPlacesDisponibles() %}
                                        <div class="alert alert-info d-flex align-items-center mb-4">
                                            <i class="ki-duotone ki-information fs-2x text-info me-4">
                                                <span class="path1"></span>
                                                <span class="path2"></span>
                                                <span class="path3"></span>
                                            </i>
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold fs-5">Places disponibles</span>
                                                <span>
                                                    {% if evenement.getPlacesRestantes() is not null %}
                                                        Il reste {{ evenement.getPlacesRestantes() }} place(s) disponible(s)
                                                    {% else %}
                                                        Places illimitées
                                                    {% endif %}
                                                </span>
                                            </div>
                                        </div>
                                        <form method="post" action="{{ path('app_evenement_register', {'id': evenement.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('register' ~ evenement.id) }}">
                                            <button type="submit" class="btn btn-primary btn-lg">
                                                <i class="ki-duotone ki-check-circle fs-2">
                                                    <span class="path1"></span>
                                                    <span class="path2"></span>
                                                </i>
                                                <span class="ms-1">S'inscrire à cet événement</span>
                                            </button>
                                        </form>
                                    {% else %}
                                        <div class="alert alert-warning d-flex align-items-center mb-0">
                                            <i class="ki-duotone ki-information fs-2x text-warning me-4">
                                                <span class="path1"></span>
                                                <span class="path2"></span>
                                                <span class="path3"></span>
                                            </i>
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold fs-5">Événement complet</span>
                                                <span>Il n'y a plus de places disponibles pour cet événement.</span>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            {% else %}
                                <div class="alert alert-info d-flex align-items-center mb-0">
                                    <i class="ki-duotone ki-information fs-2x text-info me-4">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                    </i>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold fs-5">Connexion requise</span>
                                        <span><a href="{{ path('app_login') }}" class="text-info fw-bold">Connectez-vous</a> pour vous inscrire à cet événement.</span>
                                    </div>
                                </div>
                            {% endif %}
                        </div>

                        <!-- Section Participants inscrits -->
                        <div class="mb-8">
                            <h3 class="fs-2 fw-bold text-dark mb-4">
                                <i class="ki-duotone ki-people fs-2 text-primary me-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                    <span class="path4"></span>
                                    <span class="path5"></span>
                                </i>
                                Participants inscrits
                                <span class="badge badge-light-primary ms-2">
                                    {{ evenement.getNombreInscriptions() }}{% if evenement.nombreDePlace is not null %}/{{ evenement.nombreDePlace }}{% endif %}
                                </span>
                            </h3>

                            {% set participants = [] %}
                            {% for inscription in evenement.inscriptions %}
                                {% if inscription.etat %}
                                    {% set participants = participants|merge([inscription]) %}
                                {% endif %}
                            {% endfor %}

                            {% if participants is empty %}
                                <div class="alert alert-light-primary d-flex align-items-center mb-0">
                                    <i class="ki-duotone ki-information fs-2x text-primary me-4">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                    </i>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold">Aucun participant</span>
                                        <span>Aucun participant n'est inscrit pour le moment.</span>
                                    </div>
                                </div>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table table-row-dashed align-middle gs-0 gy-4">
                                        <thead>
                                            <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                                                <th class="min-w-150px">Nom</th>
                                                <th class="min-w-150px">Prénom</th>
                                                <th class="min-w-200px">Email</th>
                                                <th class="min-w-125px">Date d'inscription</th>
                                            </tr>
                                        </thead>
                                        <tbody class="fw-semibold text-gray-700">
                                            {% for inscription in participants %}
                                                <tr>
                                                    <td>{{ inscription.refUser.nom }}</td>
                                                    <td>{{ inscription.refUser.prenom }}</td>
                                                    <td>{{ inscription.refUser.email }}</td>
                                                    <td>{{ inscription.date|date('d/m/Y H:i') }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </div>

                        <!-- Actions pour l'admin -->
                        {% if is_granted('ROLE_ADMIN') %}
                            <div class="separator my-6"></div>
                            <div class="d-flex gap-3">
                                <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-light-primary">
                                    <i class="ki-duotone ki-pencil fs-2">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                    Modifier l'événement
                                </a>
                                {{ include('evenement/_delete_form.html.twig') }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Colonne latérale (Informations) -->
            <div class="col-lg-4">
                <!-- Informations complémentaires -->
                <div class="card shadow-sm mb-6">
                    <div class="card-body">
                        <h3 class="fs-3 fw-bold text-dark mb-5">Informations</h3>

                        <!-- Type d'événement -->
                        <div class="mb-5">
                            <div class="d-flex align-items-center">
                                <i class="ki-duotone ki-tag fs-2 text-primary me-3">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                </i>
                                <div>
                                    <div class="text-gray-500 fs-7">Type d'événement</div>
                                    <div class="text-dark fw-bold">{{ evenement.type }}</div>
                                </div>
                            </div>
                        </div>

                        <!-- Date de début -->
                        {% if evenement.dateDebut %}
                            <div class="mb-5">
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-calendar fs-2 text-primary me-3">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                    <div>
                                        <div class="text-gray-500 fs-7">Date de début</div>
                                        <div class="text-dark fw-bold">{{ evenement.dateDebut|date('d/m/Y à H:i') }}</div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Date de fin -->
                        {% if evenement.dateFin %}
                            <div class="mb-5">
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-calendar-tick fs-2 text-primary me-3">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                    <div>
                                        <div class="text-gray-500 fs-7">Date de fin</div>
                                        <div class="text-dark fw-bold">{{ evenement.dateFin|date('d/m/Y à H:i') }}</div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Adresse -->
                        {% if evenement.adresse %}
                            <div class="mb-5">
                                <div class="d-flex align-items-start">
                                    <i class="ki-duotone ki-geolocation fs-2 text-primary me-3 mt-1">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                    <div>
                                        <div class="text-gray-500 fs-7">Lieu</div>
                                        <div class="text-dark fw-bold">{{ evenement.adresse }}</div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Nombre de places -->
                        {% if evenement.nombreDePlace %}
                            <div class="mb-5">
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-profile-user fs-2 text-primary me-3">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                    </i>
                                    <div>
                                        <div class="text-gray-500 fs-7">Capacité</div>
                                        <div class="text-dark fw-bold">{{ evenement.nombreDePlace }} place(s)</div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Nombre d'inscriptions -->
                        <div class="mb-0">
                            <div class="d-flex align-items-center">
                                <i class="ki-duotone ki-people fs-2 text-primary me-3">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                    <span class="path4"></span>
                                    <span class="path5"></span>
                                </i>
                                <div>
                                    <div class="text-gray-500 fs-7">Inscriptions</div>
                                    <div class="text-dark fw-bold">{{ evenement.inscriptions|length }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
